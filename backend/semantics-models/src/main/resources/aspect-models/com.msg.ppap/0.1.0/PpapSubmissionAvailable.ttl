@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.2.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <urn:samm:com.msg.ppap:0.1.0#> .

:PpapSubmissionAvailable a samm:Aspect ;
   samm:preferredName "PpapSubmissionAvailable"@en ;
   samm:preferredName "PPAP-Einreichung bereitgestellt"@de ;
   samm:description "Notification of the supplier that a submitted revision is available for pull via its Digital Twin Registry (exchange mode PUSH_NOTIFY_PULL_PAYLOAD): digital twin per approval case, submodel PpapSubmission per revision. The customer pulls the signed payload and checks it against payloadHash."@en ;
   samm:properties ( :exchangeId :revision :payloadHash :shellId :submodelId ) ;
   samm:operations ( ) ;
   samm:events ( ) .

:exchangeId a samm:Property ;
   samm:preferredName "Exchange ID"@en ;
   samm:description "Identifier generated by the customer and shared by the approval cases of customer and supplier."@en ;
   samm:characteristic :UuidCharacteristic ;
   samm:exampleValue "4a8ca33e-609f-55f1-9a79-77031bf2c0a4" .

:revision a samm:Property ;
   samm:description "Submitted revision (1, 2, ...)."@en ;
   samm:characteristic :RevisionCharacteristic ;
   samm:exampleValue "1"^^xsd:int .

:payloadHash a samm:Property ;
   samm:description "SHA-256 over the RFC 8785 canonical PpapSubmission payload that the customer pulls."@en ;
   samm:characteristic :PayloadHashCharacteristic ;
   samm:exampleValue "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" .

:shellId a samm:Property ;
   samm:description "Id of the digital twin (AAS shell descriptor) of the approval case in the supplier's DTR: urn:uuid:<exchangeId>."@en ;
   samm:characteristic :UuidUrnCharacteristic ;
   samm:exampleValue "urn:uuid:4a8ca33e-609f-55f1-9a79-77031bf2c0a4" .

:submodelId a samm:Property ;
   samm:description "Id of the submodel descriptor of the revision: urn:uuid:<name-based UUID of exchangeId and revision>."@en ;
   samm:characteristic :UuidUrnCharacteristic ;
   samm:exampleValue "urn:uuid:9b7f4c1e-2d3a-3c4b-8e5f-6a7b8c9d0e1f" .

:UuidCharacteristic a samm-c:Trait ;
   samm-c:baseCharacteristic samm-c:Text ;
   samm-c:constraint :UuidConstraint .

:UuidConstraint a samm-c:RegularExpressionConstraint ;
   samm:description "UUID (RFC 9562)"@en ;
   samm:value "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" .

:UuidUrnCharacteristic a samm-c:Trait ;
   samm-c:baseCharacteristic samm-c:Text ;
   samm-c:constraint :UuidUrnConstraint .

:UuidUrnConstraint a samm-c:RegularExpressionConstraint ;
   samm:description "UUID URN (RFC 9562)"@en ;
   samm:value "^urn:uuid:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" .

:RevisionCharacteristic a samm-c:Trait ;
   samm-c:baseCharacteristic :RevisionNumber ;
   samm-c:constraint :RevisionRange .

:RevisionNumber a samm:Characteristic ;
   samm:dataType xsd:int .

:RevisionRange a samm-c:RangeConstraint ;
   samm-c:minValue "1"^^xsd:int ;
   samm-c:lowerBoundDefinition samm-c:AT_LEAST .

:PayloadHashCharacteristic a samm-c:Trait ;
   samm-c:baseCharacteristic samm-c:Text ;
   samm-c:constraint :PayloadHashConstraint .

:PayloadHashConstraint a samm-c:RegularExpressionConstraint ;
   samm:description "SHA-256 over the RFC 8785 canonical JSON, prefixed with sha256:"@en ;
   samm:value "^sha256:[0-9a-f]{64}$" .

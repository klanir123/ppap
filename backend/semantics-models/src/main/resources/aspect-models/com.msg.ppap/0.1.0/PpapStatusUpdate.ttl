@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.2.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <urn:samm:com.msg.ppap:0.1.0#> .

:PpapStatusUpdate a samm:Aspect ;
   samm:preferredName "PpapStatusUpdate"@en ;
   samm:preferredName "PPAP-Statusmeldung"@de ;
   samm:description "Status change of an approval case on the sender's side: the supplier works on a revision (IN_PROGRESS) or the customer reviews it (IN_REVIEW)."@en ;
   samm:properties ( :exchangeId :status :revision :at :by ) ;
   samm:operations ( ) ;
   samm:events ( ) .

:status a samm:Property ;
   samm:characteristic :ReportedStatus ;
   samm:exampleValue "IN_PROGRESS" .

:ReportedStatus a samm-c:Enumeration ;
   samm:dataType xsd:string ;
   samm-c:values ( "IN_PROGRESS" "IN_REVIEW" ) .

:at a samm:Property ;
   samm:description "Time of the change."@en ;
   samm:characteristic samm-c:Timestamp ;
   samm:exampleValue "2026-11-19T10:15:30.123Z"^^xsd:dateTime .

:by a samm:Property ;
   samm:description "User or technical client that caused the change."@en ;
   samm:characteristic :UserIdCharacteristic ;
   samm:exampleValue "tier1.quality" .

:UuidCharacteristic a samm-c:Trait ;
   samm-c:baseCharacteristic samm-c:Text ;
   samm-c:constraint :UuidConstraint .

:UuidConstraint a samm-c:RegularExpressionConstraint ;
   samm:description "UUID (RFC 9562)"@en ;
   samm:value "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" .

:RevisionCharacteristic a samm-c:Trait ;
   samm-c:baseCharacteristic :RevisionNumber ;
   samm-c:constraint :RevisionRange .

:RevisionNumber a samm:Characteristic ;
   samm:dataType xsd:int .

:RevisionRange a samm-c:RangeConstraint ;
   samm-c:minValue "1"^^xsd:int ;
   samm-c:lowerBoundDefinition samm-c:AT_LEAST .

:UserIdCharacteristic a samm-c:Trait ;
   samm-c:baseCharacteristic samm-c:Text ;
   samm-c:constraint :UserIdLength .

:UserIdLength a samm-c:LengthConstraint ;
   samm-c:minValue "1"^^xsd:nonNegativeInteger ;
   samm-c:maxValue "255"^^xsd:nonNegativeInteger .

:exchangeId a samm:Property ;
   samm:preferredName "Exchange ID"@en ;
   samm:description "Identifier generated by the customer and shared by the approval cases of customer and supplier."@en ;
   samm:characteristic :UuidCharacteristic ;
   samm:exampleValue "4a8ca33e-609f-55f1-9a79-77031bf2c0a4" .

:revision a samm:Property ;
   samm:description "Revision of the submission (1, 2, ...)."@en ;
   samm:characteristic :RevisionCharacteristic ;
   samm:exampleValue "1"^^xsd:int .

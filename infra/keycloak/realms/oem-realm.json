{
  "realm": "oem",
  "displayName": "Demo-OEM AG",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "de",
    "en"
  ],
  "defaultLocale": "de",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER_QUALITY_ENGINEER",
        "description": "Qualitätsingenieur Kunde – fordert an, prüft, entscheidet"
      },
      {
        "name": "SUPPLIER_QUALITY_MANAGER",
        "description": "Qualitätsverantwortlicher Lieferant – erstellt und reicht PPF-Pakete ein"
      },
      {
        "name": "MASTERDATA_MANAGER",
        "description": "Stammdatenpfleger – Teile, Partner, Standorte, Elementkatalog"
      },
      {
        "name": "CONNECTOR_ADMIN",
        "description": "Connector-Administrator – EDC-Anbindung, Policies, Monitoring"
      },
      {
        "name": "SYSTEM_INTEGRATION",
        "description": "Technischer Client für ERP/QM-Anbindung"
      }
    ],
    "client": {}
  },
  "clients": [
    {
      "clientId": "ppap-ui",
      "name": "PPAP Connector UI",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:8081/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:8081",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "ppap-integration",
      "name": "ERP/QM-Integration",
      "publicClient": false,
      "secret": "oem-integration-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "oem.quality",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Qualitätsingenieur",
      "lastName": "OEM",
      "email": "oem.quality@oem.example",
      "realmRoles": [
        "CUSTOMER_QUALITY_ENGINEER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ]
    },
    {
      "username": "oem.masterdata",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Stammdaten",
      "lastName": "OEM",
      "email": "oem.masterdata@oem.example",
      "realmRoles": [
        "MASTERDATA_MANAGER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ]
    },
    {
      "username": "oem.admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Administrator",
      "lastName": "OEM",
      "email": "oem.admin@oem.example",
      "realmRoles": [
        "CUSTOMER_QUALITY_ENGINEER",
        "SUPPLIER_QUALITY_MANAGER",
        "MASTERDATA_MANAGER",
        "CONNECTOR_ADMIN"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-ppap-integration",
      "enabled": true,
      "serviceAccountClientId": "ppap-integration",
      "realmRoles": [
        "SYSTEM_INTEGRATION"
      ]
    }
  ]
}

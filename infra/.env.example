# Local defaults for docker compose. Copy to infra/.env to override (infra/.env is git-ignored).
# These are LOCAL DEMO values only – never reuse them in any shared or productive environment.

# --- versions (see docs/versions.md, docs/tractusx-versions.md)
EDC_VERSION=0.13.0
DTR_VERSION=0.13.0
WALLET_STUB_VERSION=0.1.0
POSTGRES_VERSION=18.7
KEYCLOAK_VERSION=26.8.2
OPENBAO_VERSION=2.7.2
SEAWEEDFS_VERSION=4.54
APP_IMAGE=ppap-connector:local

# --- participants (fictional BPNLs)
OPERATOR_BPNL=BPNL00000OPERATR
OEM_BPNL=BPNL00000000OEM1
TIER1_BPNL=BPNL000000TIER01
TIER2_BPNL=BPNL000000TIER02

# --- secrets (local only)
POSTGRES_PASSWORD=postgres-local
EDC_DB_PASSWORD=edc-local
APP_DB_PASSWORD=app-local
DTR_DB_PASSWORD=dtr-local
KEYCLOAK_DB_PASSWORD=keycloak-local
KEYCLOAK_ADMIN_PASSWORD=admin
VAULT_ROOT_TOKEN=root
EDC_MANAGEMENT_API_KEY=local-management-key
STS_CLIENT_SECRET=not-validated-by-stub

# --- host ports
OEM_APP_HOST_PORT=8081
TIER1_APP_HOST_PORT=8082
TIER2_APP_HOST_PORT=8083
KEYCLOAK_HOST_PORT=8180
OEM_EDC_MGMT_HOST_PORT=8191
TIER1_EDC_MGMT_HOST_PORT=8291
WALLET_STUB_HOST_PORT=8090
S3_HOST_PORT=8333
POSTGRES_HOST_PORT=5432

# --- logging: "ecs" = JSON logs, empty = human-readable
APP_LOG_FORMAT=ecs
